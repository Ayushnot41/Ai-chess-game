# These values must be set in your shell or hosting dashboard; this file is a template.
APP_ENV=development
COOKIE_SECURE=false
# Local development defaults to data/chess.db. Production requires PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
# CHESS_ALLOWED_ORIGINS=  # Leave unset when frontend and API share a host.
# Google OAuth 2.0 (from Google Cloud Console -> Credentials -> OAuth 2.0 Web Client)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
